# Akanksha Agree Tech (AAT) Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database Configuration (PostgreSQL URL or SQLite file path)
# For local zero-dependency out-of-the-box run: leave empty or use a file path (e.g. ./aat_dev.sqlite)
DATABASE_URL=
DATABASE_TYPE=sqlite
DATABASE_FILE=./aat_dev.sqlite

# Authentication & Security
JWT_SECRET=aat_super_secret_development_key_do_not_use_in_prod
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Development OTP Adapter
DEV_OTP_AUTO_APPROVE=true
DEV_OTP_CODE=123456
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Marketplace & Matching Policy
MATCHING_PROVIDER_LIMIT=5
OFFER_WINDOW_MINUTES=60
DEFAULT_PROVIDER_RADIUS_KM=25

# External Adapters (Test Mode)
PAYMENT_GATEWAY_ADAPTER=simulated
SMS_GATEWAY_ADAPTER=dev_sink
MAP_PROVIDER_ADAPTER=haversine_test
